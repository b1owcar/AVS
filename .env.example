# Local AI Vision Studio — copy to .env and adjust.
# Prefer paths relative to the project root (office install: D:\avs).

# Runtime mode: real | simulation
LAVS_RUN_MODE=simulation

# Bind — default localhost only
LAVS_HOST=127.0.0.1
LAVS_PORT=18765

# Data roots (relative to project root — works when app lives in D:\avs)
LAVS_DATA_DIR=./data
LAVS_MODEL_DIR=./data/models
LAVS_OUTPUT_DIR=./data/outputs
LAVS_UPLOAD_DIR=./data/uploads
LAVS_LOG_DIR=./data/logs
LAVS_DB_PATH=./data/db/lavs.sqlite3

# Optional external ComfyUI
LAVS_COMFYUI_URL=http://127.0.0.1:8188
# LAVS_COMFYUI_DIR=D:\avs\engines\ComfyUI
# LAVS_COMFYUI_OUTPUT_DIR=D:\avs\engines\ComfyUI\output
# LAVS_COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors

# Isolated SDXL Diffusers Python (set by install-sdxl.ps1)
# LAVS_IMAGE_PYTHON=D:\avs\envs\image\.venv\Scripts\python.exe
# Optional warm SDXL HTTP worker (start_sdxl_worker.ps1)
# LAVS_SDXL_WORKER_URL=http://127.0.0.1:18767

# Pose worker (install-pose.ps1 / scripts/linux/install-pose.sh)
# LAVS_POSE_PYTHON=D:\avs\envs\pose\.venv\Scripts\python.exe

# Motion transfer Stage 2 (install-motion.ps1)
# LAVS_MOTION_PYTHON=D:\avs\envs\motion\.venv\Scripts\python.exe

# TRELLIS Phase 6 (prefer Linux install-trellis.sh)
# LAVS_TRELLIS_PYTHON=/path/to/envs/trellis/.venv/bin/python

# Office deploy
# LAVS_INSTALL_ROOT=D:\avs
# LAVS_ALLOW_MODEL_DOWNLOAD=1
# LAVS_SKIP_HARDWARE_VERIFICATION=1

# Resource policy
LAVS_GPU_MEMORY_RESERVE_MB=512
LAVS_MAX_CONCURRENT_GPU_TASKS=1

# Remote bind warning: only set HOST to 0.0.0.0 after understanding LAN exposure risk.
